{
  "appId": "io.github.apeuriox.rewind-lazer",
  "productName": "Rewind Lazer",
  "electronVersion": "19.0.3",
  "executableName": "rewind-lazer",
  "artifactName": "rewind-lazer-${version}-${os}-${arch}.${ext}",
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  },
  "generateUpdatesFilesForAllChannels": false,
  "publish": [
    {
      "provider": "github",
      "owner": "Apeuriox",
      "repo": "rewind",
      "channel": "lazer",
      "releaseType": "release"
    }
  ],
  "directories": {
    "output": "dist/electron",
    "buildResources": "../../tools/electron-builder/build-resources"
  },
  "files": [
    {
      "from": "../../dist/apps/rewind-electron",
      "to": "rewind-electron",
      "filter": ["main.js"]
    },
    {
      "from": "../../dist/apps/desktop-frontend",
      "to": "desktop-frontend"
    },
    {
      "from": "../../dist/apps/desktop-backend",
      "to": "desktop-backend"
    },
    {
      "from": "../../dist/apps/desktop-backend-preload",
      "to": "desktop-backend-preload"
    },
    {
      "from": "../../dist/apps/desktop-frontend-preload",
      "to": "desktop-frontend-preload"
    },
    "index.js",
    "package.json"
  ],
  "asarUnpack": ["node_modules/realm/prebuilds/node/realm.node"],
  "extraResources": [
    {
      "from": "../../resources/Skins",
      "to": "Skins"
    }
  ]
}
