{
  "appId": "io.github.apeuriox.rewind-lazer",
  "productName": "Rewind Lazer",
  "electronVersion": "19.0.3",
  "executableName": "rewind-lazer",
  "artifactName": "rewind-lazer-${version}-${os}-${arch}.${ext}",
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  },
  "generateUpdatesFilesForAllChannels": false,
  "publish": [
    {
      "provider": "github",
      "owner": "Apeuriox",
      "repo": "rewind",
      "channel": "lazer",
      "releaseType": "release"
    }
  ],
  "directories": {
    "output": "dist/electron",
    "buildResources": "tools/electron-builder/build-resources",
    "app": "."
  },
  "snap": {
    "publish": ["github"]
  },
  "files": [
    {
      "from": "dist/apps/desktop",
      "filter": ["index.js", "assets"]
    },
    {
      "from": "dist/apps/desktop/frontend",
      "to": "frontend"
    },
    {
      "from": "dist/apps/desktop/backend",
      "to": "backend"
    },
    "package.json"
  ],
  "asarUnpack": ["node_modules/realm/prebuilds/node/realm.node"],
  "extraResources": [
    {
      "from": "resources/Skins",
      "to": "Skins"
    }
  ]
}
